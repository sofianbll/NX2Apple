diff --git a/dm/gfx/tests/t_ups.c b/dm/gfx/tests/t_ups.c
new file mode 100644
index 0000000..07d5e82
--- /dev/null
+++ b/dm/gfx/tests/t_ups.c
@@ -0,0 +1,163 @@
+// Resolution upscaling unit test (CPU only): the pure arithmetic of nvn_mtl.m's upscaling section in ../nvn/nvn_ups.h, with the expectations hand-calculated.
+// Regions: equal game regions map to equal scaled regions whatever their offsets (the audit's 1.5x case: x=1,w=2 and x=0,w=2 used to come out 4 and 3 wide), clamped to the texture.
+// Occlusion queries: samples counted in a scaled pass come back divided by the factor squared, rounded. Present crop: a scaled window texture's crop in its own pixels.
+// Descriptor ranks: which reflection bindings the translator counts as texture and image descriptors (render_scale[1 + i]).
+// Which render targets scale (shape, flags, screen-like size, the 4K ceiling: IMAGE no longer keeps one unscaled), and which image bindings demote their texture.
+#include "../nvn/nvn_ups.h"
+#include <stdio.h>
+#include <string.h>
+
+static int fails;
+#define CHECK(cond, ...) do { if (!(cond)) { fails++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+// One region through nvn_ups_region; returns the four values for comparison
+static void region(int x, int y, int w, int h, double f, long tw, long th, int out[4]) {
+    out[0] = x; out[1] = y; out[2] = w; out[3] = h;
+    nvn_ups_region(&out[0], &out[1], &out[2], &out[3], f, tw, th);
+}
+
+int main(void) {
+    int a[4], b[4];
+    // 1.5x: the parity case from the audit. x=1,w=2 → offset 2 (1.5 rounded), width 3; x=0,w=2 → offset 0, width 3: the same width for the same game width
+    region(1, 0, 2, 2, 1.5, 0, 0, a); region(0, 0, 2, 2, 1.5, 0, 0, b);
+    CHECK(a[0] == 2 && a[2] == 3, "1.5x x=1,w=2 → %d,%d", a[0], a[2]);
+    CHECK(b[0] == 0 && b[2] == 3, "1.5x x=0,w=2 → %d,%d", b[0], b[2]);
+    CHECK(a[2] == b[2] && a[3] == b[3], "equal game regions must have equal scaled sizes");
+    // 2x: exact
+    region(3, 5, 7, 9, 2, 0, 0, a);
+    CHECK(a[0] == 6 && a[1] == 10 && a[2] == 14 && a[3] == 18, "2x → %d,%d %dx%d", a[0], a[1], a[2], a[3]);
+    // 1x: untouched
+    region(3, 5, 7, 9, 1, 0, 0, a);
+    CHECK(a[0] == 3 && a[1] == 5 && a[2] == 7 && a[3] == 9, "1x must not change a region");
+    // a one-texel region never vanishes
+    region(0, 0, 1, 1, 1.5, 0, 0, a);
+    CHECK(a[2] >= 1 && a[3] >= 1, "1 texel at 1.5x → %dx%d", a[2], a[3]);
+    // clamping: a region reaching the game's right edge stays inside the scaled texture (1280x720 at 1.5x = 1920x1080)
+    region(1279, 719, 1, 1, 1.5, 1920, 1080, a);
+    CHECK(a[0] + a[2] <= 1920 && a[1] + a[3] <= 1080 && a[2] >= 1, "clamped edge texel → %d+%d, %d+%d", a[0], a[2], a[1], a[3]);
+    region(1200, 700, 200, 100, 1.5, 1920, 1080, a);
+    CHECK(a[0] == 1800 && a[2] == 120 && a[1] == 1050 && a[3] == 30, "clamped region → %d+%d, %d+%d", a[0], a[2], a[1], a[3]);
+    // a region entirely outside is empty, not negative
+    region(2000, 0, 10, 10, 1.5, 1920, 1080, a);
+    CHECK(a[2] == 0 && a[0] == 1920, "outside → %d+%d", a[0], a[2]);
+    // the whole texture maps to the whole scaled texture (1280x720 at 1.5x and 2x)
+    region(0, 0, 1280, 720, 1.5, 1920, 1080, a);
+    CHECK(a[0] == 0 && a[1] == 0 && a[2] == 1920 && a[3] == 1080, "whole 1.5x → %dx%d", a[2], a[3]);
+    region(0, 0, 1280, 720, 2, 2560, 1440, a);
+    CHECK(a[2] == 2560 && a[3] == 1440, "whole 2x → %dx%d", a[2], a[3]);
+
+    // Occlusion query samples: f² per game pixel, rounded; 1x and an unset factor (0) pass the count through
+    CHECK(nvn_ups_samples(400, 2) == 100, "2x: 400 → %llu", (unsigned long long)nvn_ups_samples(400, 2));
+    CHECK(nvn_ups_samples(9, 1.5) == 4, "1.5x: 9 / 2.25 = 4 → %llu", (unsigned long long)nvn_ups_samples(9, 1.5));
+    CHECK(nvn_ups_samples(10, 1.5) == 4, "1.5x: 10 / 2.25 = 4.44 → %llu", (unsigned long long)nvn_ups_samples(10, 1.5));
+    CHECK(nvn_ups_samples(11, 1.5) == 5, "1.5x: 11 / 2.25 = 4.89 → %llu", (unsigned long long)nvn_ups_samples(11, 1.5));
+    CHECK(nvn_ups_samples(7, 1) == 7 && nvn_ups_samples(7, 0) == 7, "1x / unset keep the count");
+    CHECK(nvn_ups_samples(0, 2) == 0, "no samples stay none");
+    CHECK(nvn_ups_samples(1, 2) == 1 && nvn_ups_samples(1, 1.5) == 1 && nvn_ups_samples(2, 2) == 1, "a query that passed anything reports at least 1 → %llu %llu %llu",
+          (unsigned long long)nvn_ups_samples(1, 2), (unsigned long long)nvn_ups_samples(1, 1.5), (unsigned long long)nvn_ups_samples(2, 2));
+
+    // Present crop: Breath of the Wild's 1280x720 crop of a 1920x1080 window texture made at 2x (3840x2160)
+    int crop[4] = {0, 0, 1280, 720}, out[4];
+    CHECK(nvn_ups_crop(crop, 2, 3840, 2160, out) && out[0] == 0 && out[1] == 0 && out[2] == 2560 && out[3] == 1440, "2x crop → %d,%d %dx%d", out[0], out[1], out[2], out[3]);
+    CHECK(nvn_ups_crop(crop, 1.5, 2880, 1620, out) && out[2] == 1920 && out[3] == 1080, "1.5x crop → %dx%d", out[2], out[3]);
+    int none[4] = {0, 0, 0, 0};
+    CHECK(!nvn_ups_crop(none, 2, 3840, 2160, out), "an unset crop is reported unset");
+    CHECK(!nvn_ups_crop(NULL, 2, 3840, 2160, out), "a NULL crop is reported unset");
+    int off[4] = {320, 180, 1280, 720};
+    CHECK(nvn_ups_crop(off, 2, 3840, 2160, out) && out[0] == 640 && out[1] == 360 && out[2] == 2560 && out[3] == 1440, "offset crop → %d,%d %dx%d", out[0], out[1], out[2], out[3]);
+
+    // Descriptor ranks: sampled textures, uniform-buffer handles and buffer textures of array length 1 count; arrays, images, samplers and buffers do not
+    CHECK(nvn_ups_tex_desc(NVN_RB_TEX, 0) && nvn_ups_tex_desc(NVN_RB_TEX, 1) && nvn_ups_tex_desc(NVN_RB_TEXU, 0) && nvn_ups_tex_desc(NVN_RB_TBUF, 0), "single textures count");
+    CHECK(!nvn_ups_tex_desc(NVN_RB_TEXU, 32) && !nvn_ups_tex_desc(NVN_RB_TEXD, 8) && !nvn_ups_tex_desc(NVN_RB_TEXA, 32), "arrays do not count");
+    CHECK(!nvn_ups_tex_desc(NVN_RB_IMG, 0) && !nvn_ups_tex_desc(NVN_RB_SAMP, 0) && !nvn_ups_tex_desc(NVN_RB_CBUF, 0) && !nvn_ups_tex_desc(NVN_RB_SUPPORT, 0), "images, samplers, buffers do not count");
+
+    // Which render targets scale (nvn_ups_size_flags_ok). Flags: 0x1 DISPLAY, 0x4 IMAGE, 0x8 COMPRESSIBLE, 0x10 LINEAR, 0x20 SPARSE, 0x40 LINEAR_RENDER_TARGET, 0x2 VIDEO_DECODE
+    CHECK(nvn_ups_size_flags_ok(1920, 1080, 0x8, 0, 2), "a COMPRESSIBLE 1920x1080 target scales at 2x (FINAL FANTASY CRYSTAL CHRONICLES)");
+    CHECK(nvn_ups_size_flags_ok(1600, 900, 0xc, 0, 2) && nvn_ups_size_flags_ok(1920, 1080, 0xc, 0, 1.5), "IMAGE | COMPRESSIBLE targets scale (KTGL flags every one: Hyrule Warriors' 1600x900 scene)");
+    CHECK(nvn_ups_size_flags_ok(1600, 900, 0x4, 1, 2), "an IMAGE depth target scales (depth needs no COMPRESSIBLE)");
+    CHECK(!nvn_ups_size_flags_ok(1920, 1080, 0x4, 0, 2), "an IMAGE colour texture without COMPRESSIBLE or DISPLAY is not scaled when made (the movie planes are data)");
+    // Held until a pass draws into it (nvn_ups_classify): scale, leave or hold
+    CHECK(nvn_ups_classify(1920, 1080, 0x0, 0, 2) == NVN_UPS_HOLD && nvn_ups_classify(1920, 1080, 0x4, 0, 1.5) == NVN_UPS_HOLD,
+          "a colour texture with neither COMPRESSIBLE nor DISPLAY is held (Super Mario Bros. Wonder's scene colour; a movie plane no pass draws into stays as it is)");
+    CHECK(nvn_ups_classify(1920, 1080, 0x8, 0, 2) == NVN_UPS_SCALE && nvn_ups_classify(1920, 1080, 0x1, 0, 2) == NVN_UPS_SCALE && nvn_ups_classify(1920, 1080, 0x0, 1, 2) == NVN_UPS_SCALE,
+          "COMPRESSIBLE, DISPLAY and depth targets scale when made");
+    CHECK(nvn_ups_classify(1920, 1080, 0x10, 0, 2) == NVN_UPS_LEAVE && nvn_ups_classify(1920, 1080, 0x2, 0, 2) == NVN_UPS_LEAVE && nvn_ups_classify(256, 256, 0x0, 0, 2) == NVN_UPS_LEAVE
+          && nvn_ups_classify(3840, 2160, 0x0, 0, 2) == NVN_UPS_LEAVE && nvn_ups_classify(1920, 1080, 0x8, 0, 1) == NVN_UPS_LEAVE,
+          "linear and video-decode textures, sizes that are not screen-like or pass 4K, and factor 1 are left, not held");
+    CHECK(nvn_ups_screen_ok(320, 180, 2) && !nvn_ups_screen_ok(319, 180, 2) && !nvn_ups_screen_ok(1024, 1024, 2) && nvn_ups_screen_ok(2560, 1440, 1.5) && !nvn_ups_screen_ok(2560, 1440, 2),
+          "screen-like: at least 320x180, an aspect of 1.4 to 1.9, within 4K scaled");
+    CHECK(!nvn_ups_size_flags_ok(1920, 1080, 0x8 | 0x10, 0, 2) && !nvn_ups_size_flags_ok(1920, 1080, 0x8 | 0x40, 0, 2) && !nvn_ups_size_flags_ok(1920, 1080, 0x8 | 0x20, 0, 2)
+          && !nvn_ups_size_flags_ok(1920, 1080, 0x8 | 0x2, 0, 2), "linear, linear render target, sparse and video-decode textures stay");
+    CHECK(!nvn_ups_size_flags_ok(3840, 2160, 0xd, 0, 2) && !nvn_ups_size_flags_ok(3840, 2160, 0xd, 0, 1.5), "a 4K swap chain (DISPLAY | IMAGE | COMPRESSIBLE) stays: past the 4K ceiling");
+    CHECK(nvn_ups_size_flags_ok(2560, 1440, 0x8, 0, 1.5) && !nvn_ups_size_flags_ok(2560, 1440, 0x8, 0, 2), "2560x1440: 1.5x reaches exactly 3840x2160, 2x would pass it");
+    CHECK(nvn_ups_size_flags_ok(1920, 1080, 0x9, 0, 2), "a 1920x1080 window texture (DISPLAY) reaches exactly 3840x2160 at 2x");
+    CHECK(!nvn_ups_size_flags_ok(1024, 1024, 0x8, 0, 2) && !nvn_ups_size_flags_ok(256, 144, 0x8, 0, 2) && !nvn_ups_size_flags_ok(1740, 200, 0xc, 0, 2), "square, small and banner-shaped targets stay");
+    CHECK(!nvn_ups_size_flags_ok(1920, 1080, 0x8, 0, 1) && !nvn_ups_size_flags_ok(1920, 1080, 0x8, 0, 0), "nothing scales at 1x or unset");
+    // Shapes (nvn_ups_shape_ok): single-level 2D textures and short 2D arrays (KTGL's 4-layer G-buffer arrays) scale; mipmapped, multisample, 3D, cube and long arrays do not
+    CHECK(nvn_ups_shape_ok(NVN_TEXTURE_TARGET_2D, 1, 1, 1) && nvn_ups_shape_ok(NVN_TEXTURE_TARGET_2D, 1, 1, 0), "a single-level 2D texture");
+    CHECK(nvn_ups_shape_ok(NVN_TEXTURE_TARGET_2D_ARRAY, 1, 4, 1) && nvn_ups_shape_ok(NVN_TEXTURE_TARGET_2D_ARRAY, 1, 8, 1), "2D arrays of up to 8 layers");
+    CHECK(!nvn_ups_shape_ok(NVN_TEXTURE_TARGET_2D_ARRAY, 1, 9, 1) && !nvn_ups_shape_ok(NVN_TEXTURE_TARGET_2D_ARRAY, 2, 4, 1), "a longer array, or a mipmapped one, stays");
+    CHECK(!nvn_ups_shape_ok(NVN_TEXTURE_TARGET_2D, 10, 1, 1) && !nvn_ups_shape_ok(NVN_TEXTURE_TARGET_2D, 1, 1, 4) && !nvn_ups_shape_ok(NVN_TEXTURE_TARGET_2D_MULTISAMPLE, 1, 1, 4),
+          "mipmapped and multisample textures stay");
+    CHECK(!nvn_ups_shape_ok(NVN_TEXTURE_TARGET_3D, 1, 1, 1) && !nvn_ups_shape_ok(NVN_TEXTURE_TARGET_CUBEMAP, 1, 6, 1) && !nvn_ups_shape_ok(NVN_TEXTURE_TARGET_RECTANGLE, 1, 1, 1),
+          "3D, cube and rectangle textures stay");
+    // Written images demote; image loads take render_scale entries after the textures
+    CHECK(nvn_ups_img_writes(NVN_RB_IMG, 1, 0) && nvn_ups_img_writes(NVN_RB_IMG, 0, 1) && nvn_ups_img_writes(NVN_RB_IMGU, 1, 0), "a written or atomic image slot demotes its texture, its handle in an image slot or in a uniform buffer");
+    CHECK(!nvn_ups_img_writes(NVN_RB_IMG, 0, 0) && !nvn_ups_img_writes(NVN_RB_TEX, 1, 0) && !nvn_ups_img_writes(NVN_RB_SBUFP, 1, 0), "read-only images, textures and buffers do not");
+    CHECK(nvn_ups_img_desc(NVN_RB_IMG, 0) && nvn_ups_img_desc(NVN_RB_IMG, 1) && nvn_ups_img_desc(NVN_RB_IMGU, 1) && !nvn_ups_img_desc(NVN_RB_IMG, 4) && !nvn_ups_img_desc(NVN_RB_TEX, 0), "single images are image descriptors, their handle in a slot or in a uniform buffer; arrays and textures are not");
+
+    // The game's upscaler resolved by the host. Shape: KTGL's FSR-style pass binds a constant buffer, one sampled texture with its sampler and one written image
+    { int ti = -1, oi = -1;
+      nvn_rbind fsr[4] = {{.kind = NVN_RB_CBUF}, {.kind = NVN_RB_TEX, .reg = 0}, {.kind = NVN_RB_SAMP}, {.kind = NVN_RB_IMG, .reg = 0, .rw = 1}};
+      CHECK(nvn_ups_bypass_shape(fsr, 4, &ti, &oi) && ti == 1 && oi == 3, "one sampled texture and one written image: the upscaler's shape (bindings %d, %d)", ti, oi);
+      nvn_rbind two_tex[3] = {{.kind = NVN_RB_TEX, .reg = 0}, {.kind = NVN_RB_TEX, .reg = 1}, {.kind = NVN_RB_IMG, .rw = 1}};
+      CHECK(!nvn_ups_bypass_shape(two_tex, 3, &ti, &oi), "a second texture (a depth, a history) is a reconstruction, not a resampling");
+      nvn_rbind two_img[3] = {{.kind = NVN_RB_TEX}, {.kind = NVN_RB_IMG, .reg = 0, .rw = 1}, {.kind = NVN_RB_IMG, .reg = 1, .rw = 1}};
+      CHECK(!nvn_ups_bypass_shape(two_img, 3, &ti, &oi), "two written images are not one output");
+      nvn_rbind ro_img[2] = {{.kind = NVN_RB_TEX}, {.kind = NVN_RB_IMG, .rw = 0}};
+      CHECK(!nvn_ups_bypass_shape(ro_img, 2, &ti, &oi), "a read-only image is an input, so there is no output");
+      nvn_rbind atom[2] = {{.kind = NVN_RB_TEX}, {.kind = NVN_RB_IMG, .rw = 1, .atom = 1}};
+      CHECK(!nvn_ups_bypass_shape(atom, 2, &ti, &oi), "an atomic image is a counter, not an output");
+      nvn_rbind ubo_tex[3] = {{.kind = NVN_RB_TEXU, .n = 1}, {.kind = NVN_RB_TEX}, {.kind = NVN_RB_IMG, .rw = 1}};
+      CHECK(!nvn_ups_bypass_shape(ubo_tex, 3, &ti, &oi), "a bindless texture beside the sampled one is a second input");
+      nvn_rbind ubo_img[2] = {{.kind = NVN_RB_TEX}, {.kind = NVN_RB_IMGU, .rw = 1, .n = 1}};
+      CHECK(!nvn_ups_bypass_shape(ubo_img, 2, &ti, &oi), "an output bound by a handle in a uniform buffer is not the shape: the resolve binds its output by slot");
+      nvn_rbind no_tex[2] = {{.kind = NVN_RB_CBUF}, {.kind = NVN_RB_IMG, .rw = 1}};
+      CHECK(!nvn_ups_bypass_shape(no_tex, 2, &ti, &oi), "no sampled texture: nothing to resample");
+      nvn_rbind with_buf[4] = {{.kind = NVN_RB_SBUFP, .rw = 1}, {.kind = NVN_RB_TEX}, {.kind = NVN_RB_SUPPORT}, {.kind = NVN_RB_IMG, .rw = 1}};
+      CHECK(nvn_ups_bypass_shape(with_buf, 4, &ti, &oi) && ti == 1 && oi == 3, "buffers and the support buffer do not change the shape"); }
+    // The rectangle of the scene the upscaler reads, from FSR 1's EASU constants: Hyrule Warriors' first field renders 1152x648 of its 1600x900 scene into 1920x1080
+    { uint32_t vw = 0, vh = 0;
+      float c[16] = {1152.0f / 1920, 648.0f / 1080, 0.5f * (1152.0f / 1920) - 0.5f, 0.5f * (648.0f / 1080) - 0.5f, 1.0f / 1600, 1.0f / 900, 1.0f / 1600, -1.0f / 900, -1.0f / 1600, 2.0f / 900, 1.0f / 1600, 2.0f / 900, 0, 4.0f / 900, 0, 0};
+      CHECK(nvn_ups_fsr_rect(c, 1600, 900, 1920, 1080, &vw, &vh) && vw == 1152 && vh == 648, "EASU constants name the 1152x648 viewport of the 1600x900 scene (got %ux%u)", vw, vh);
+      c[0] = 1; c[1] = 1; c[2] = c[3] = 0;
+      CHECK(!nvn_ups_fsr_rect(c, 1600, 900, 1920, 1080, &vw, &vh), "a viewport of the output's size lies past the 1600x900 texture: refused");
+      c[0] = 1600.0f / 1920; c[1] = 900.0f / 1080; c[2] = 0.5f * c[0] - 0.5f; c[3] = 0.5f * c[1] - 0.5f;
+      CHECK(nvn_ups_fsr_rect(c, 1600, 900, 1920, 1080, &vw, &vh) && vw == 1600 && vh == 900, "the whole scene when the viewport is the texture (got %ux%u)", vw, vh);
+      CHECK(!nvn_ups_fsr_rect(c, 1280, 720, 1920, 1080, &vw, &vh), "constants of another texture size are not this scene's: refused");
+      float d[16]; memcpy(d, c, sizeof d); d[2] = 0;
+      CHECK(!nvn_ups_fsr_rect(d, 1600, 900, 1920, 1080, &vw, &vh), "con0.zw not the half terms: not EASU's constants");
+      memcpy(d, c, sizeof d); d[7] = 1.0f / 900;
+      CHECK(!nvn_ups_fsr_rect(d, 1600, 900, 1920, 1080, &vw, &vh), "con1.w positive: not EASU's constants");
+      float z[16] = {0};
+      CHECK(!nvn_ups_fsr_rect(z, 1600, 900, 1920, 1080, &vw, &vh), "zeros are not constants");
+      memcpy(d, c, sizeof d); d[0] = 1.1f; d[2] = 0.5f * d[0] - 0.5f;
+      CHECK(!nvn_ups_fsr_rect(d, 1600, 900, 1920, 1080, &vw, &vh), "a viewport past the texture is refused"); }
+    // Sizes (the scene's rectangle in the game's pixels, as the host holds it, the output): Hyrule Warriors' 1600x900 scene into its 1920x1080 image
+    CHECK(nvn_ups_bypass_ok(1152, 648, 2304, 1296, 1920, 1080), "2x: a 1152x648 viewport is 2304x1296, past the 1920x1080 output");
+    CHECK(!nvn_ups_bypass_ok(1152, 648, 1728, 972, 1920, 1080), "1.5x: the same viewport is 1728x972, under the output: the game's kernel runs");
+    CHECK(nvn_ups_bypass_ok(1600, 900, 3200, 1800, 1920, 1080), "2x: a 3200x1800 scene holds more than the 1920x1080 output");
+    CHECK(nvn_ups_bypass_ok(1600, 900, 2400, 1350, 1920, 1080), "1.5x: 2400x1350 still past 1920x1080");
+    CHECK(!nvn_ups_bypass_ok(1600, 900, 1600, 900, 1920, 1080), "1x (the scene at the game's size): the game's kernel runs");
+    CHECK(!nvn_ups_bypass_ok(1200, 675, 1800, 1012, 1920, 1080), "a dynamic resolution whose scaled size falls under the output: the game's kernel runs");
+    CHECK(nvn_ups_bypass_ok(1200, 675, 2400, 1350, 1920, 1080), "the same scene at 2x is still past the output");
+    CHECK(!nvn_ups_bypass_ok(1600, 900, 3200, 1800, 1600, 900), "an output of the scene's size is a per-pixel effect, not an upscale");
+    CHECK(!nvn_ups_bypass_ok(1600, 900, 3200, 1800, 800, 450), "a smaller output is the game's own downsample");
+    CHECK(!nvn_ups_bypass_ok(1600, 900, 3200, 1800, 1920, 1200), "another shape (1920x1200) is not the whole scene resampled");
+    CHECK(!nvn_ups_bypass_ok(1600, 900, 3200, 1800, 3840, 2160), "an output past the scene the host holds would need an upscale, not a resolve");
+    CHECK(!nvn_ups_bypass_ok(1600, 900, 3200, 1800, 1920, 900), "larger in one direction and equal in the other is not of the same shape");
+    CHECK(!nvn_ups_bypass_ok(0, 0, 0, 0, 1920, 1080) && !nvn_ups_bypass_ok(1600, 900, 3200, 1800, 0, 0), "empty sizes are refused");
+
+    printf("t_ups: %s (%d failures)\n", fails ? "FAIL" : "OK", fails);
+    return fails ? 1 : 0;
+}
diff --git a/dm/gfx/tests/t_ups_resolve.m b/dm/gfx/tests/t_ups_resolve.m
new file mode 100644
index 0000000..a0c550f
--- /dev/null
+++ b/dm/gfx/tests/t_ups_resolve.m
@@ -0,0 +1,116 @@
+// Resolution upscaling: the game's own spatial upscaler resolved by the host (DM_UPSCALE_GAME; nvn_mtl.m ups_bypass_encode). An upscaler-shaped compute shader (one sampled
+// texture, one written image) with FSR's EASU constants in its constant buffer, dispatched with a 1600x900 sRGB scene the host made at 2x (3200x1800), of which the constants
+// name a 1200x675 viewport, and a 1920x1080 output image, has its output written by the host: the viewport filtered down, so a viewport of two flat colours comes out as the same
+// two colours away from their edge, with every filter (box, tent, Lanczos-2), nothing of the scene outside the viewport reaches the output, and the sRGB encoding survives the
+// round trip (the output is read back as bytes). DM_UPSCALE_GAME=keep, constants that are not EASU's, an output of the scene's own size, and a run without DM_UPSCALE (the last
+// run) leave the dispatch to the game's kernel. Runs under any profile: the shape, the constants and the sizes decide, not the shader's key
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s\n", label); } } while (0)
+// A single-level 2D texture of the game's size w x h with NVN flags (COMPRESSIBLE makes a render target the host scales; IMAGE alone is data, left at the game's size), initialized
+// in the caller's object as a game's is: mtl_tex_init records that object's address (g_tex_live), and mtl_tex_release tells the texture's own object from a copy by it
+static void texture(tex_t *t, uint64_t serial, unsigned w, unsigned h, int format, uint32_t flags) {
+    *t = (tex_t){.magic = MAGIC('T','E','X',0), .serial = serial, .off = serial << 24};
+    t->d = (nvn_texdesc){.target = NVN_TEXTURE_TARGET_2D, .format = format, .width = w, .height = h, .depth = 1, .levels = 1, .samples = 1, .flags = flags};
+    nvn_tex_layout(&t->d, &t->L); mtl_tex_init(t);
+}
+static void fill(id<MTLTexture> t, MTLClearColor c) {
+    id<MTLCommandBuffer> cb = q_cb(); MTLRenderPassDescriptor *rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture = t; rp.colorAttachments[0].loadAction = MTLLoadActionClear; rp.colorAttachments[0].storeAction = MTLStoreActionStore; rp.colorAttachments[0].clearColor = c;
+    [[cb renderCommandEncoderWithDescriptor:rp] endEncoding]; [cb commit]; [cb waitUntilCompleted];
+}
+// The texels of an RGBA8 texture, as stored (sRGB-encoded bytes for an sRGB format)
+static NSData *bytes_of(id<MTLTexture> t) {
+    NSUInteger n = t.width * t.height; id<MTLBuffer> b = [g_dev newBufferWithLength:n * 4 options:MTLResourceStorageModeShared];
+    if (!b) { fprintf(stderr, "readback buffer did not allocate\n"); return [NSData data]; }   // an empty readback fails the checks that read it
+    id<MTLCommandBuffer> cb = q_cb(); id<MTLBlitCommandEncoder> e = [cb blitCommandEncoder];
+    [e copyFromTexture:t sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(t.width, t.height, 1) toBuffer:b destinationOffset:0 destinationBytesPerRow:t.width * 4 destinationBytesPerImage:n * 4];
+    [e endEncoding]; [cb commit]; [cb waitUntilCompleted];
+    return [NSData dataWithBytes:b.contents length:n * 4];
+}
+// Whether every texel of the w x h output left of column edge - margin holds `left` and every one right of edge + margin holds `right` (bytes, within tol): the resolve of a
+// scene whose left half is one flat colour and right half another keeps both flat and the edge where it was (at most `margin` output texels wide: the filter's radius)
+static int halves(id<MTLTexture> t, const uint8_t left[4], const uint8_t right[4], NSUInteger edge, NSUInteger margin, int tol, const char *what) {
+    NSData *d = bytes_of(t); const uint8_t *p = d.bytes;
+    if (d.length < t.width * t.height * 4) return 0;
+    for (NSUInteger y = 0; y < t.height; y++) for (NSUInteger x = 0; x < t.width; x++) {
+        if (x + margin >= edge && x < edge + margin) continue;
+        const uint8_t *want = x < edge ? left : right, *got = p + (y * t.width + x) * 4;
+        for (int c = 0; c < 4; c++) if (abs((int)got[c] - (int)want[c]) > tol) {
+            fprintf(stderr, "%s: texel %lu,%lu channel %d: %d, expected %d\n", what, (unsigned long)x, (unsigned long)y, c, got[c], want[c]); return 0; }
+    }
+    return 1;
+}
+static NvShader *upscaler(void) {   // the shape of KTGL's FSR-style pass: a constant buffer, one sampled texture with its sampler, one written image
+    NvShader *s = [NvShader new]; snprintf(s->key, sizeof s->key, "%s", "0123456789abcdef_b");
+    s->rf.nb = 4; s->rf.b[0] = (nvn_rbind){.kind = NVN_RB_CBUF}; s->rf.b[1] = (nvn_rbind){.kind = NVN_RB_TEX, .dtt = MTLTextureType2D, .dpf = NVN_DPF_FLOAT, .reg = 0};
+    s->rf.b[2] = (nvn_rbind){.kind = NVN_RB_SAMP}; s->rf.b[3] = (nvn_rbind){.kind = NVN_RB_IMG, .dtt = MTLTextureType2D, .dpf = NVN_DPF_FLOAT, .reg = 0, .rw = 1};
+    return s;
+}
+int main(void) { @autoreleasepool {
+    mtl_init();
+    int scaled = ups_factor() > 1;   // DM_UPSCALE=2 in the runs that resolve; unset in the last one
+    // The scene: a 1600x900 sRGB render target, 3200x1800 at 2x; its left half one colour, its right half another. The output: a 1920x1080 sRGB image (IMAGE alone: unscaled)
+    tex_t scene, out, same, patch;
+    texture(&scene, 77, 1600, 900, NVN_FORMAT_RGBA8_SRGB, NVN_TEXTURE_FLAGS_COMPRESSIBLE | NVN_TEXTURE_FLAGS_IMAGE); texture(&out, 78, 1920, 1080, NVN_FORMAT_RGBA8_SRGB, NVN_TEXTURE_FLAGS_IMAGE);
+    texture(&same, 79, 1600, 900, NVN_FORMAT_RGBA8_SRGB, NVN_TEXTURE_FLAGS_IMAGE); texture(&patch, 80, 4, 4, NVN_FORMAT_RGBA8_SRGB, NVN_TEXTURE_FLAGS_COMPRESSIBLE);
+    mtl_reg_tex(701, &scene, NULL); mtl_reg_image(702, &out, NULL); mtl_reg_image(703, &same, NULL);
+    id<MTLTexture> st = tex_mtl(&scene), ot = tex_mtl(&out), pt = tex_mtl(&patch);
+    CHECK(st.width == (scaled ? 3200u : 1600u) && ot.width == 1920 && ot.height == 1080, scaled ? "the scene is made at 2x and the output at the game's size" : "at 1x both are at the game's size");
+    // The viewport the constants name: 1200x675 of the 1600x900 scene (2400x1350 of the scaled one), the rest of the texture black, which must never reach the output
+    const unsigned vw = 1200, vh = 675, sx = scaled ? 2400 : 1200, sy = scaled ? 1350 : 675;
+    const MTLClearColor a = MTLClearColorMake(0.5, 0.25, 0.75, 1), b = MTLClearColorMake(0.1, 0.8, 0.3, 1);
+    tex_t patch_a; texture(&patch_a, 81, 4, 4, NVN_FORMAT_RGBA8_SRGB, NVN_TEXTURE_FLAGS_COMPRESSIBLE); id<MTLTexture> pat = tex_mtl(&patch_a);
+    fill(st, MTLClearColorMake(0, 0, 0, 1)); fill(pat, a); fill(pt, b);
+    // The viewport in colour a and its left half in colour b, from 4x4 patches (nearest draws; scaling copies as the host's own, in the scene's texels)
+    mtl_sub_begin();
+    { NVNcopyRegion sr = {0, 0, 0, 4, 4, 1}, dr = {0, 0, 0, (int)sx, (int)sy, 1}, dl = {0, 0, 0, (int)sx / 2, (int)sy, 1};
+      CHECK(copy_t2t_draw(pat, st, 0, 0, 0, 0, &sr, &dr, 0, 0) && copy_t2t_draw(pt, st, 0, 0, 0, 0, &sr, &dl, 0, 0), "the viewport and its left half are drawn"); }
+    CHECK(mtl_wait(mtl_sub_commit(), 5000000000ull) && !mtl_last_commit_error(), "the scene's submission completes");
+    uint8_t ea[4], eb[4];   // the two colours as the sRGB scene stores them: what the output must hold again after the decode, the filter and the encode
+    { NSData *d = bytes_of(st); const uint8_t *p = d.bytes; CHECK(d.length >= sx * 4, "the scene reads back"); if (d.length >= sx * 4) { memcpy(eb, p, 4); memcpy(ea, p + (sx - 1) * 4, 4); } else memset(ea, 0, 4), memset(eb, 0, 4); }
+    // The constant buffer, in guest memory: FSR's EASU constants for the viewport, the texture and the output (nvn_ups_fsr_rect)
+    float *con = NULL; if (posix_memalign((void **)&con, (size_t)getpagesize(), (size_t)getpagesize())) abort(); memset(con, 0, (size_t)getpagesize()); mtl_pool_add(con, (uint64_t)getpagesize());
+    con[0] = (float)vw / 1920; con[1] = (float)vh / 1080; con[2] = 0.5f * con[0] - 0.5f; con[3] = 0.5f * con[1] - 0.5f;
+    con[4] = 1.0f / 1600; con[5] = 1.0f / 900; con[6] = con[4]; con[7] = -con[5]; con[8] = -con[4]; con[9] = 2 * con[5]; con[10] = con[4]; con[11] = 2 * con[5]; con[13] = 4 * con[5];
+    NvShader *sh = upscaler();
+    memset(&S, 0, sizeof S); S.tex[5][0] = 701; S.img[5][0] = 702; S.ubo[5][0] = (p_bind_buf){.stage = 5, .index = 0, .addr = (uint64_t)(uintptr_t)con, .size = 256};
+    const char *filters[3] = {"box", "tent", "lanczos"}; const NSUInteger margins[3] = {2, 3, 5};   // output texels either side of the edge the filter may blend (radius 0.5, 1 or 2 footprints of 1.67 texels)
+    for (int f = 0; f < 3; f++) {
+        setenv("DM_UPSCALE_GAME_FILTER", filters[f], 1);
+        fill(ot, MTLClearColorMake(0, 0, 0, 1));
+        mtl_sub_begin(); int done = ups_bypass_encode(sh);
+        CHECK(done == scaled, scaled ? "the upscaler's dispatch is resolved by the host" : "without DM_UPSCALE the dispatch is left to the game's kernel");
+        CHECK(mtl_wait(mtl_sub_commit(), 5000000000ull) && !mtl_last_commit_error(), "the resolve's submission completes");
+        if (scaled) { char what[64]; snprintf(what, sizeof what, "%s filter", filters[f]);
+            CHECK(halves(ot, eb, ea, 960, margins[f], 2, what), "both flat colours come out flat on their side of the edge, sRGB-encoded as the scene stores them"); }
+        else { uint8_t black[4] = {0, 0, 0, 255}; CHECK(halves(ot, black, black, 960, 0, 0, "untouched"), "the output is untouched at 1x"); }
+    }
+    unsetenv("DM_UPSCALE_GAME_FILTER");
+    if (scaled) {
+        S.ubo[5][0].size = 0; uint64_t kept0 = g_ups_byp_kept;   // no constant buffer read: the rectangle is unknown
+        mtl_sub_begin(); CHECK(!ups_bypass_encode(sh) && g_ups_byp_kept == kept0 + 1, "without EASU's constants the rectangle is unknown: the game's kernel runs, counted as kept"); mtl_wait(mtl_sub_commit(), 5000000000ull);
+        S.ubo[5][0].size = 256; con[2] = 0;   // the half term broken: not EASU's constants
+        mtl_sub_begin(); CHECK(!ups_bypass_encode(sh), "constants that are not EASU's leave the dispatch alone"); mtl_wait(mtl_sub_commit(), 5000000000ull);
+        con[2] = 0.5f * con[0] - 0.5f;
+        setenv("DM_UPSCALE_GAME", "keep", 1);
+        mtl_sub_begin(); CHECK(!ups_bypass_encode(sh), "DM_UPSCALE_GAME=keep leaves the dispatch to the game's kernel"); mtl_wait(mtl_sub_commit(), 5000000000ull);
+        unsetenv("DM_UPSCALE_GAME");
+        S.img[5][0] = 703; uint64_t kept = g_ups_byp_kept; con[0] = con[1] = 1; con[2] = con[3] = 0;   // the constants name the whole 1600x900 scene into a 1600x900 output
+        mtl_sub_begin(); CHECK(!ups_bypass_encode(sh) && g_ups_byp_kept == kept + 1, "an output of the scene's own size is a per-pixel pass: left to the game's kernel, counted as kept"); mtl_wait(mtl_sub_commit(), 5000000000ull);
+        con[0] = (float)vw / 1920; con[1] = (float)vh / 1080; con[2] = 0.5f * con[0] - 0.5f; con[3] = 0.5f * con[1] - 0.5f;
+        S.img[5][0] = 702; S.tex[5][0] = 0;
+        mtl_sub_begin(); CHECK(!ups_bypass_encode(sh), "an unbound scene slot leaves the dispatch alone"); mtl_wait(mtl_sub_commit(), 5000000000ull);
+        CHECK(sh->up_byp == 1, "the shape is decided once per shader");
+        NvShader *two = upscaler(); two->rf.nb = 5; two->rf.b[4] = (nvn_rbind){.kind = NVN_RB_TEX, .dtt = MTLTextureType2D, .dpf = NVN_DPF_FLOAT, .reg = 1};
+        S.tex[5][0] = 701; S.tex[5][1] = 701;
+        mtl_sub_begin(); CHECK(!ups_bypass_encode(two) && two->up_byp == 2, "a second sampled texture is not the upscaler's shape"); mtl_wait(mtl_sub_commit(), 5000000000ull);
+    }
+    printf("t_ups_resolve (%s): %d checks, %d failed\n", scaled ? "2x" : "1x", checks, failed);
+    return failed != 0;
+}}
