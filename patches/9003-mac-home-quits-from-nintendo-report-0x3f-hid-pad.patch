From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sofian <sofianbll.x@gmail.com>
Date: Wed, 11 Nov 2026 16:31:03 +0100
Subject: [PATCH] Mac: Home quits from Nintendo report 0x3F HID pads

Track Home (usage 13) and positional A/B outside guest button mapping, and poll the quit prompt when they change. Other generic HID layouts and twin Pro Controllers read from report 0x30 stay unchanged.

Upstream-Status: pending
Reason: Let PowerA Pro Controller clones quit with Home like other pads.
Issue: seedds/nxnative#989
---
 dm/host/controllers_mac.m         | 13 +++++++++++--
 dm/host/home_quit.h               |  3 ++-
 dm/host/pad_hid_mac.h             |  2 +-
 dm/host/tests/t_controllers_mac.m | 29 +++++++++++++++++++++++++++++
 docs/mac-controllers.md           |  4 +++-
 docs/playing.md                   |  2 +-
 docs/reference/services.md        |  4 ++--
 7 files changed, 49 insertions(+), 8 deletions(-)

diff --git a/dm/host/controllers_mac.m b/dm/host/controllers_mac.m
index 82ed0ec5..55a8a4e6 100644
--- a/dm/host/controllers_mac.m
+++ b/dm/host/controllers_mac.m
@@ -25,7 +25,7 @@ enum { PAD_OFF, PAD_DPAD, PAD_LEFT_STICK, PAD_RIGHT_STICK, PAD_TOUCH };
 @public
     int slot, map[DM_PAD_BUTTONS];
     steam_state input;
-    uint32_t quit_buttons; // raw Triton buttons, including changes while guest input is suspended
+    uint32_t quit_buttons; // raw Triton or report 0x3F buttons, including changes while guest input is suspended
     IOHIDDeviceRef device; // Triton only: proprietary output and feature reports
     joycon_pad *joycon; // borrowed until joycon_detach, with an independent player slot
     hid_pad *generic; // borrowed until hidpad_detach; never a Triton output route
@@ -340,6 +340,10 @@ GCController *front_controllers_quit_buttons(int *home, int *a, int *b) {
             // Triton's Guide and physical A (bottom) / B (right), before DM_PAD_MAP.
             *home|=!!(d->quit_buttons & (1u<<22));
             *a|=!!(d->quit_buttons & DM_BTN_B); *b|=!!(d->quit_buttons & DM_BTN_A);
+        } else if(d->generic) {
+            // Report 0x3F's Home and positional A / B, before DM_PAD_MAP.
+            *home|=!!(d->quit_buttons & (1u<<22));
+            *a|=!!(d->quit_buttons & DM_BTN_A); *b|=!!(d->quit_buttons & DM_BTN_B);
         }
     }
     return holder;
@@ -476,7 +480,12 @@ static void hidpad_read(hid_pad *hid) {
     uint32_t buttons=(uint32_t)(pro ? hid->pro_m : pad_hid_buttons(&hid->st));
     d->input=(steam_state){.buttons=buttons,.lx=s[0],.ly=s[1],.rx=s[2],.ry=s[3]};
     if(d->slot<0 && g_press_to_join && !buttons) return;
-    controller_connect(d); controller_publish(d);
+    uint32_t quit=!pro && hid->nintendo ? buttons & (DM_BTN_A|DM_BTN_B) : 0;
+    if(!pro && hid->nintendo && (hid->st.buttons & (1u<<12))) quit|=1u<<22; // report 0x3F's Home is usage 13
+    uint32_t changed=d->quit_buttons ^ quit; d->quit_buttons=quit;
+    controller_connect(d);
+    if(controller_listening() && (changed & ((1u<<22)|DM_BTN_A|DM_BTN_B))) front_home_poll();
+    controller_publish(d);
 }
 static void hidpad_motion(hid_pad *hid, const pro_motion_sample *s, int n) {
     DMController *d=controller_for_hid(hid);
