diff --git a/dm/host/tests/t_controllers_mac.m b/dm/host/tests/t_controllers_mac.m
index 700b15a6..fc632349 100644
--- a/dm/host/tests/t_controllers_mac.m
+++ b/dm/host/tests/t_controllers_mac.m
@@ -850,6 +850,34 @@ static void test_home_quit_routing(void) {
     hidpad_removed(NULL,kIOReturnSuccess,NULL,hid); hid_fixture_finish();
     puts("Home quit: adapter ownership, physical labels, prompt/settle gating and focus recovery: OK");
 }
+static void test_nintendo_home_quit(void) {
+    hid_fixture_start();
+    __block home_quit q={0}; __block double now=0;
+    test_home_poll=^{
+        int home,a,b; front_controllers_quit_buttons(&home,&a,&b);
+        front_controllers_quit_prompt(hq_blocks_input(hq_step(&q,now,home,a,b)));
+    };
+    // Usage 13 is not Home without Nintendo's report 0x3F layout.
+    NSDictionary *plain=generic_device(913);
+    hidpad_found(NULL,kIOReturnSuccess,NULL,(__bridge IOHIDDeviceRef)plain);
+    generic_value(g_hidpads,kHIDPage_Button,13,1,0,1);
+    now+=HQ_HOLD_S; front_home_poll(); assert(q.phase==HQ_IDLE);
+    generic_value(g_hidpads,kHIDPage_Button,13,0,0,1);
+    hidpad_removed(NULL,kIOReturnSuccess,NULL,(__bridge IOHIDDeviceRef)plain);
+
+    NSMutableDictionary *props=[generic_device(914) mutableCopy];
+    props[@kIOHIDVendorIDKey]=@0; props[@kIOHIDProductIDKey]=@0; props[@kIOHIDProductKey]=@"Lic Pro Controller";
+    props[@"elements"]=@[@{@"page":@(kHIDPage_Button),@"usage":@1,@"report":@(PAD_HID_NINTENDO_REPORT)}];
+    hidpad_found(NULL,kIOReturnSuccess,NULL,(__bridge IOHIDDeviceRef)props);
+    hid_pad *pad=g_hidpads; assert(pad && pad->nintendo);
+    generic_value(pad,kHIDPage_Button,13,1,0,1); assert(q.phase==HQ_HOLDING);
+    now+=HQ_HOLD_S; front_home_poll(); assert(q.phase==HQ_PROMPT);
+    generic_value(pad,kHIDPage_Button,13,0,0,1); assert(q.phase==HQ_PROMPT);
+    generic_value(pad,kHIDPage_Button,2,1,0,1); assert(q.phase==HQ_QUIT);
+    test_home_poll=nil; front_controllers_quit_prompt(0);
+    hidpad_removed(NULL,kIOReturnSuccess,NULL,(__bridge IOHIDDeviceRef)props); hid_fixture_finish();
+    puts("Nintendo HID report 0x3F: Home hold and A quit, other HID usage 13 ignored: OK");
+}
 static void test_generic_hid_routing(void) {
     for(int merged=0;merged<2;merged++) {
         hid_fixture_start(); g_merge=merged; g_slots=(pad_slots){0};
@@ -1038,6 +1066,7 @@ int main(int argc, char **argv) {
         test_merged_hotplug();
         test_generic_hid_routing();
         test_home_quit_routing();
+        test_nintendo_home_quit();
         test_nintendo_hid();
         test_generic_hid_ownership();
         test_generic_unknown_identity();
